{
  // Cloudflare deployment config.
  //
  // TWO THINGS HERE ARE LOAD-BEARING.
  //
  // 1. assets.directory — WITHOUT IT, `wrangler deploy` auto-detects the output
  //    directory as "." and publishes the entire repository. On the first
  //    attempt it read 2235 files from the repo root and only failed because a
  //    122 MiB binary in node_modules exceeded the asset size limit. Had the
  //    repo been slightly smaller, docs/, apps-script/ and tests/ would have
  //    gone live on servecleaning.com. scripts/build-site.sh stages the
  //    allow-list into _site; this makes Cloudflare publish that and only that.
  //
  // 2. vars — the two Apps Script /exec URLs. They live HERE rather than in
  //    script.js because script.js is served publicly: anyone could read the
  //    endpoints and POST junk into the sheet. The repo is private, so keeping
  //    them in this file is fine. If it ever goes public, move them to secrets
  //    (`wrangler secret put WEBHOOK_URL`) — the Worker reads env either way.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serve",
  "compatibility_date": "2026-07-28",

  // The Worker runs for any request that does not match a static file, which
  // is how /api/* reaches it. See src/worker.js for why the proxy exists.
  // The pricing engine reaches the Worker through src/engine.generated.mjs, a
  // real ES module built from the two classic <script> files. No bundler rules
  // are needed for it — that was tried and did not work. See
  // scripts/build-engine-module.js.
  "main": "src/worker.js",

  "assets": {
    "directory": "./_site",
    // Lets the Worker hand non-API requests back to the static asset server.
    "binding": "ASSETS"
  },

  // SECRETS ARE NOT LISTED HERE, AND MUST NOT BE.
  //
  // The Worker expects ONE provider key, set as a Cloudflare SECRET rather
  // than as a var:
  //
  //     npx wrangler secret put GEOAPIFY_KEY     // /api/address
  //
  // RENTCAST_KEY IS NO LONGER READ, as of 2026-09-08. /api/property was
  // deleted: measured against 15 real Boston condo addresses it matched the
  // actual UNIT 0% of the time, because a tower with hundreds of apartments
  // answers as one record with one bedroom count. Pre-filling a wrong number
  // is worse than an empty field. The secret can be deleted from the
  // dashboard and the RentCast plan cancelled — nothing here reads it, and a
  // test asserts the Worker contains no reference to it.
  //
  // The secret-versus-var distinction is load-bearing on this project because
  // deploys come from git. A deploy replaces the dashboard's `vars` with the
  // list below, so a key added through the dashboard as a plaintext variable
  // is wiped by the next push — silently, since the endpoint simply starts
  // answering "no_provider" again. Secrets live outside this file and survive
  // deploys.
  //
  // It is also a key we are billed against. Geoapify's free tier is capped
  // daily, and a leaked key would exhaust it for real customers rather than
  // run up a charge — a quieter failure and a worse one. A var is readable in
  // the dashboard forever, while a secret is write-only.
  //
  // Named here as documentation only. No value may ever appear in this file.
  "vars": {
    // Booking webhook — writes JOBS / LEADS / PROPERTIES and flips the slot.
    "WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxVWfrn2Mos2-yO1AhDe20tpnFcAdc-nZ_6zb0qK02msdyJZVETgLQ77TvUnxHf5jWMBQ/exec",
    // Availability feed — time slots for step 3.
    "AVAILABILITY_URL": "https://script.google.com/macros/s/AKfycbzumNZZ9KI56KZuM2QlbhlB4QVp3cRS5Q_v8Z3jO0PW5CENCi2NDRExQL2Ko3vA93XM/exec"
  },

  // THE CACHE, AND EVERY SPEND GUARD WE HAVE.
  //
  // The suggest endpoint treats this as optional — every use is behind
  // `if (kv)`, so the Worker runs without it. That is deliberate: a KV outage
  // must not take the booking form down. But it means an ABSENT binding fails
  // silently and expensively, because the three things it carries are:
  //
  //   the cache        180 days per suggestion. Without it every keystroke is
  //                    a fresh billable call and the hit rate never climbs.
  //   the rate limit   per-IP, per-hour.
  //   the monthly cap  the hard stop that keeps a bad day off the invoice.
  //
  // It ran unbound until 2026-09-08 — tolerable while one endpoint made one
  // call per address, and not tolerable once type-ahead multiplied that by
  // five. The BINDING NAME is a leftover from the deleted property endpoint;
  // renaming it would mean a new namespace and throwing away a warm cache,
  // which is a worse trade than a slightly stale name.
  //
  // THE ID IS NOT A SECRET, unlike the provider key above. It is a
  // pointer, useless without account credentials, and it belongs in this file
  // rather than only in the dashboard: deploys come from git and reconcile the
  // Worker against this config, so a binding that exists only in the console
  // is one a future push can quietly drop.
  "kv_namespaces": [
    {
      "binding": "PROPERTY_CACHE",
      "id": "97c9cd38df564718a3233286989a1f0d"
    }
  ],

  // Written in the expanded form the dashboard now uses, so the two agree.
  //
  // The shorthand `{ "enabled": true }` was here first, and Cloudflare flagged
  // the drift for the same reason it flags variables: a deploy from git
  // overwrites the dashboard with whatever this file says. Turning traces off
  // in the console and leaving the shorthand here would have let the next push
  // silently turn them back on.
  //
  // logs — needed. The demand count for /api/address comes from console.log
  // lines this captures.
  //
  // traces — off. Distributed spans across services, useful for finding where
  // latency goes in a multi-hop request. This Worker makes one upstream call;
  // the log line already says everything a span would.
  //
  // invocation_logs — Cloudflare's own per-request entries. See the note in
  // handleAddressSuggest: our logging deliberately records a ZIP and a hash
  // rather than a street address, and these entries do not follow that rule
  // for the request URL.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
