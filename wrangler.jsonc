{
	// Cloudflare deployment config.
	//
	// TWO THINGS HERE ARE LOAD-BEARING.
	//
	// 1. assets.directory — WITHOUT IT, `wrangler deploy` auto-detects the output
	//    directory as "." and publishes the entire repository. On the first
	//    attempt it read 2235 files from the repo root and only failed because a
	//    122 MiB binary in node_modules exceeded the asset size limit. Had the
	//    repo been slightly smaller, docs/, apps-script/ and tests/ would have
	//    gone live on servecleaning.com. scripts/build-site.sh stages the
	//    allow-list into _site; this makes Cloudflare publish that and only that.
	//
	// 2. vars — the two Apps Script /exec URLs. They live HERE rather than in
	//    script.js because script.js is served publicly: anyone could read the
	//    endpoints and POST junk into the sheet. The repo is private, so keeping
	//    them in this file is fine. If it ever goes public, move them to secrets
	//    (`wrangler secret put WEBHOOK_URL`) — the Worker reads env either way.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "serve",
	"compatibility_date": "2026-07-28",
	// The Worker runs for any request that does not match a static file, which
	// is how /api/* reaches it. See src/worker.js for why the proxy exists.
	// The pricing engine reaches the Worker through src/engine.generated.mjs, a
	// real ES module built from the two classic <script> files. No bundler rules
	// are needed for it — that was tried and did not work. See
	// scripts/build-engine-module.js.
	"main": "src/worker.js",
	// Private room images. Do not enable r2.dev or attach a public domain.
	// PHOTO_BRIDGE_SECRET must match the Apps Script property of the same name.
	"r2_buckets": [
		{
			"binding": "BOOKING_PHOTOS",
			"bucket_name": "serve-booking-photos"
		}
	],
	// THE MARKETPLACE DATABASE (2026-11-06) — Cloudflare D1, read by
	// src/marketplace.js as env.MARKET_DB. Created 2026-11-06 with
	// `npx wrangler d1 create serve-marketplace`.
	//
	// THE BINDING NAME IS LOAD-BEARING. The code reads env.MARKET_DB; wrangler's
	// own prompt suggested `serve_marketplace`, which would bind fine and leave
	// the code seeing nothing — /providers stuck on "opening soon" with no error
	// anywhere. /api/health `has_marketplace_db` is the check.
	//
	// Schema and seed, once, from this folder (Windows PowerShell: npx.cmd):
	//   npx wrangler d1 migrations apply serve-marketplace --remote
	//   node scripts/seed-partners.js
	//   npx wrangler d1 execute serve-marketplace --remote --file db/seed-first-partners.sql
	//
	// The seed lists NOBODY. A company goes public only when its row has
	// listed = 1 and status = 'approved' — set by hand after the owner approves.
	//
	// THE ID IS NOT A SECRET, like the KV id below: a pointer, useless without
	// account credentials, and it belongs here so a git deploy cannot drop it.
	"d1_databases": [
		{
			"binding": "MARKET_DB",
			"database_name": "serve-marketplace",
			"database_id": "c7f45090-66ee-4199-a3cf-8a4088658911",
			"migrations_dir": "migrations"
		}
	],
	// TWO SCHEDULES, DOING DIFFERENT THINGS. src/worker.js branches on
	// controller.cron, so these strings must match the CRON_* constants there
	// EXACTLY — a test asserts they do. Editing one without the other fails
	// silently: the daily cleanup simply stops happening and nothing reports it.
	//
	//   17 8 * * *    daily photo-storage cleanup — deletes objects from R2
	//   */5 * * * *   keeps both Apps Script apps warm; see warmUpstreams()
	//
	// The five-minute interval is matched to the availability feed's own 5-minute
	// cache, so a ping lands about as the cache expires and the next visitor gets
	// a warm container AND a fresh response.
	"triggers": {
		"crons": [
			"17 8 * * *",
			"*/5 * * * *"
		]
	},
	"assets": {
		"directory": "./_site",
		// Lets the Worker hand non-API requests back to the static asset server.
		"binding": "ASSETS",
		// "/" matches _site/index.html, which the asset server would answer
		// without ever running the Worker. Running the Worker first for "/"
		// lets it serve the waitlist (WAITLIST_IS_HOME) or the marketplace
		// preview (?preview=). Exact match: every other page stays static.
		"run_worker_first": ["/"]
	},
	// THE WAITLIST HOMEPAGE (2026-11-09). The serve-waitlist Worker (repo
	// iceuriel/serve-waitlist) has no domain of its own; this binding is how
	// servecleaning.com reaches it. See WAITLIST_IS_HOME in src/worker.js.
	// serve-waitlist must be deployed before this Worker, or this deploy fails.
	"services": [
		{ "binding": "WAITLIST", "service": "serve-waitlist" }
	],
	// SECRETS ARE NOT LISTED HERE, AND MUST NOT BE.
	//
	// Set as Cloudflare SECRETS rather than vars:
	//
	//     npx wrangler secret put GEOAPIFY_KEY     // /api/address
	//     npx wrangler secret put QUOTE_SECRET     // /api/quote
	//     npx wrangler secret put PHOTO_BRIDGE_SECRET   // /api/photos
	//     npx wrangler secret put STRIPE_SECRET_KEY     // /api/checkout
	//     npx wrangler secret put STRIPE_WEBHOOK_SECRET // /api/stripe-webhook
	//     npx wrangler secret put PAYMENT_BRIDGE_SECRET // the write-back
	//     npx wrangler secret put MARKET_BRIDGE_SECRET  // estimate emails (webhook r63)
	//     npx wrangler secret put MARKET_PREVIEW_KEY    // /providers/<slug>?preview=
	//
	// MARKET_BRIDGE_SECRET must match the Apps Script Script Property of the same
	// name, and must differ from the photo and payment bridge secrets — one
	// credential never opens another surface. Set it LAST, after webhook r63 is
	// deployed (see the r63 note at the top of webhook.gs).
	// MARKET_PREVIEW_KEY lets the founder see an unlisted profile before it is
	// public. Anyone with the link can see every unlisted draft, so treat it like
	// a password and rotate it if it is ever shared.
	//
	// THE THREE PAYMENT SECRETS ARE NOT INTERCHANGEABLE AND MUST NOT BE SET TO
	// THE SAME VALUE.
	//
	//   STRIPE_SECRET_KEY      Stripe's key. MOVES REAL MONEY when it starts
	//                          `sk_live_`. /api/health reports `stripe_mode`
	//                          precisely so a live key cannot reach production
	//                          unnoticed — that is the one mistake here a
	//                          redeploy cannot undo.
	//   STRIPE_WEBHOOK_SECRET  `whsec_…`, from the Stripe dashboard's webhook
	//                          endpoint. Verifies that a callback really came
	//                          from Stripe. WITHOUT IT THE ROUTE REFUSES rather
	//                          than trusting the caller: /api/stripe-webhook
	//                          writes payment state for whatever job id it is
	//                          handed, so unverified it would be a public
	//                          endpoint for marking any booking paid.
	//   PAYMENT_BRIDGE_SECRET  Ours, not Stripe's. Any long random string, and
	//                          it must MATCH the Apps Script Script Property of
	//                          the same name — that is what lets the booking
	//                          webhook tell this Worker from anyone else who has
	//                          found the public /exec URL. A DIFFERENT value
	//                          from PHOTO_BRIDGE_SECRET, for the same reason the
	//                          four ticket audiences differ: one credential must
	//                          never open another surface.
	//
	// `can_charge: true` with `can_record_payments: false` is the combination
	// worth checking for after any secret change. It means cards are charged and
	// nothing is written down — every customer surface goes on saying "Not yet
	// authorized" to people who have already paid.
	//
	// QUOTE_SECRET signs the price the server issues, so that a figure which has
	// been sitting in a browser can be proved to have come from here before
	// anything charges a card against it. See "SIGNED QUOTES" in src/worker.js.
	//
	// It is NOT the Apps Script TICKET_SECRET and must not be set to the same
	// value. That key mints the four ticket audiences, and the rule there is that
	// none of them opens another; a quote signature is a fifth audience and gets
	// its own key so that leaking one can never be worked back into a portal
	// link. Any long random string — `openssl rand -hex 32`.
	//
	// Unbound, the site still works and still books: quotes go out unsigned and
	// /api/health reports `can_sign: false`. What it cannot do is authenticate a
	// price, so nothing becomes chargeable without a human. Check can_sign after
	// any change to the Worker's secrets.
	//
	// RENTCAST_KEY IS NO LONGER READ, as of 2026-09-08. /api/property was
	// deleted: measured against 15 real Boston condo addresses it matched the
	// actual UNIT 0% of the time, because a tower with hundreds of apartments
	// answers as one record with one bedroom count. Pre-filling a wrong number
	// is worse than an empty field. The secret can be deleted from the
	// dashboard and the RentCast plan cancelled — nothing here reads it, and a
	// test asserts the Worker contains no reference to it.
	//
	// The secret-versus-var distinction is load-bearing on this project because
	// deploys come from git. A deploy replaces the dashboard's `vars` with the
	// list below, so a key added through the dashboard as a plaintext variable
	// is wiped by the next push — silently, since the endpoint simply starts
	// answering "no_provider" again. Secrets live outside this file and survive
	// deploys.
	//
	// It is also a key we are billed against. Geoapify's free tier is capped
	// daily, and a leaked key would exhaust it for real customers rather than
	// run up a charge — a quieter failure and a worse one. A var is readable in
	// the dashboard forever, while a secret is write-only.
	//
	// Named here as documentation only. No value may ever appear in this file.
	"vars": {
		// Booking webhook — writes JOBS / LEADS / PROPERTIES and flips the slot.
		"WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxVWfrn2Mos2-yO1AhDe20tpnFcAdc-nZ_6zb0qK02msdyJZVETgLQ77TvUnxHf5jWMBQ/exec",
		// Availability feed — time slots for step 3.
		"AVAILABILITY_URL": "https://script.google.com/macros/s/AKfycbzumNZZ9KI56KZuM2QlbhlB4QVp3cRS5Q_v8Z3jO0PW5CENCi2NDRExQL2Ko3vA93XM/exec"
	},
	// THE CACHE, AND EVERY SPEND GUARD WE HAVE.
	//
	// The suggest endpoint treats this as optional — every use is behind
	// `if (kv)`, so the Worker runs without it. That is deliberate: a KV outage
	// must not take the booking form down. But it means an ABSENT binding fails
	// silently and expensively, because the three things it carries are:
	//
	//   the cache        180 days per suggestion. Without it every keystroke is
	//                    a fresh billable call and the hit rate never climbs.
	//   the rate limit   per-IP, per-hour.
	//   the monthly cap  the hard stop that keeps a bad day off the invoice.
	//
	// It ran unbound until 2026-09-08 — tolerable while one endpoint made one
	// call per address, and not tolerable once type-ahead multiplied that by
	// five. The BINDING NAME is a leftover from the deleted property endpoint;
	// renaming it would mean a new namespace and throwing away a warm cache,
	// which is a worse trade than a slightly stale name.
	//
	// THE ID IS NOT A SECRET, unlike the provider key above. It is a
	// pointer, useless without account credentials, and it belongs in this file
	// rather than only in the dashboard: deploys come from git and reconcile the
	// Worker against this config, so a binding that exists only in the console
	// is one a future push can quietly drop.
	"kv_namespaces": [
		{
			"binding": "PROPERTY_CACHE",
			"id": "97c9cd38df564718a3233286989a1f0d"
		}
	],
	// Written in the expanded form the dashboard now uses, so the two agree.
	//
	// The shorthand `{ "enabled": true }` was here first, and Cloudflare flagged
	// the drift for the same reason it flags variables: a deploy from git
	// overwrites the dashboard with whatever this file says. Turning traces off
	// in the console and leaving the shorthand here would have let the next push
	// silently turn them back on.
	//
	// logs — needed. The demand count for /api/address comes from console.log
	// lines this captures.
	//
	// traces — off. Distributed spans across services, useful for finding where
	// latency goes in a multi-hop request. This Worker makes one upstream call;
	// the log line already says everything a span would.
	//
	// invocation_logs — Cloudflare's own per-request entries. See the note in
	// handleAddressSuggest: our logging deliberately records a ZIP and a hash
	// rather than a street address, and these entries do not follow that rule
	// for the request URL.
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	}
}