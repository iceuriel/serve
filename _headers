# Response headers for the published site.
#
# Read from the publish directory by BOTH Cloudflare Pages and Netlify, so the
# behaviour is identical whichever host is live. scripts/build-site.sh copies
# this file into _site/.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The booking flow must never be served stale. script.js carries the webhook
# and availability endpoint URLs; a cached copy keeps POSTing to an endpoint
# that may have been retired, and the customer sees success either way.
#
# charset=utf-8 is explicit because Cloudflare serves text/javascript with no
# charset, unlike GitHub Pages. script.js contains user-facing non-ASCII — the
# "✓ We serve <zip>" confirmation and the "Reserving…" button label — and a
# classic script without a declared charset only inherits the document encoding
# by convention. Undeclared, those render as mojibake on the two strings a
# customer is most likely to be looking at.
# Both paths: "/" and "/index.html" are matched separately, and almost every
# real visitor arrives on "/".
/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Same revalidate rule as script.js, and for the same reason: the two are one
# pricing engine split across two files, and a fresh script.js paired with a
# cached serve-geo-data.js would price homes off a stale ZIP map with nothing
# reporting a fault. Its ZIP labels are internal, but the file carries non-ASCII
# in its comments, so the charset is declared here too rather than left to the
# document encoding.
/serve-geo-data.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/style.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Legal pages, linked from Twilio's A2P 10DLC campaign registration. Carriers
# re-fetch these after approval, so they must stay 200 and must not be served
# stale after an edit. Both the extensionless and .html paths are declared
# because the asset server resolves /privacy to /privacy.html.
/privacy
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/privacy.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/sms-terms
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/sms-terms.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Published pricing and scope. Both render their tables from script.js, so a
# stale copy of either would show numbers that no longer match the calculator —
# the one thing the shared price function exists to prevent. Same revalidate
# rule as the other pages, and both path forms because the asset server
# resolves /pricing to /pricing.html.
/pricing
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/pricing.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/services
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/services.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Photos are content-stable and heavy. Cache them properly.
/images/*
  Cache-Control: public, max-age=604800
